# Copie para .env (ignorado pelo Git) e preencha com a sua chave.
# Uso local:  set -a; source .env; set +a
# Em produção, este arquivo fica ao lado do deploy/compose.yaml na VPS.
ALPHA_VANTAGE_API_KEY=

# Opcional: gateway compatível com OpenAI para a narrativa da Pesquisa IA.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Monitor: alertas (console, telegram, email)
ALERT_CHANNELS=console
ALERT_MIN_SCORE=80
ALERT_COOLDOWN_DAYS=3
ALERT_MAX_PER_RUN=5
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
